# Playwright E2E configuration.
# Copy to `.env.e2e.local` (git-ignored) and fill in. Never commit real values.

# Base URL of the LOCAL app under test. Must match NEXTAUTH_URL so the
# NextAuth session cookie stays same-origin.
E2E_BASE_URL="http://localhost:3000"

# DEDICATED database for E2E only. Must be different from DATABASE_URL.
# The suite aborts if these are identical, and write journeys (enrollment,
# progress, course creation) stay disabled while this is unset.
# E2E_DATABASE_URL="postgresql://user:password@localhost:5432/anmolofficial_e2e"
# E2E_DIRECT_URL="postgresql://user:password@localhost:5432/anmolofficial_e2e"

# Test accounts. Defaults fall back to the prisma/seed_roles.ts demo accounts
# and the DEMO_*_PASSWORD values already present in .env.
# E2E_STUDENT_EMAIL="student.demo@anmolofficial.com"
# E2E_STUDENT_PASSWORD=""
# E2E_INSTRUCTOR_EMAIL="instructor.demo@anmolofficial.com"
# E2E_INSTRUCTOR_PASSWORD=""
# E2E_ADMIN_EMAIL="admin.demo@anmolofficial.com"
# E2E_ADMIN_PASSWORD=""

# Optional fixture overrides. When unset, the suite discovers a published
# course and lesson from the UI itself.
# E2E_COURSE_ID=""
# E2E_LESSON_ID=""

# Payment sandbox. The payment journey skips unless PAYU_ENV=TEST and both
# merchant credentials are present. Never set PAYU_ENV=PRODUCTION for E2E.
# PAYU_ENV="TEST"
# PAYU_MERCHANT_KEY=""
# PAYU_MERCHANT_SECRET=""