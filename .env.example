# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
DIRECT_URL="postgresql://user:password@localhost:5432/dbname"

# Auth
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# PayU (payment gateway)
# Merchant key and salt come from the PayU dashboard under Settings > API Keys.
# Use TEST credentials with PAYU_ENV=TEST until the full flow is verified.
# Never commit real credentials.
PAYU_MERCHANT_KEY="your-payu-merchant-key"
PAYU_MERCHANT_SECRET="your-payu-salt"
# TEST  -> https://test.payu.in/_payment  (sandbox, no real money)
# PRODUCTION -> https://secure.payu.in/_payment  (live charges)
PAYU_ENV="TEST"

# Optional: Cloudflare R2 object storage for uploads.
# With all five set, uploads go to R2; otherwise they fall back to local disk
# and then to inline data URIs, which are capped.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_PUBLIC_URL=""