generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                 @id @default(uuid())
  email                String                 @unique
  role                 UserRole               @default(STUDENT)
  passwordHash         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  name                 String?
  image                String?
  provider             String                 @default("credentials")
  providerAccountId    String?                @unique
  bio                  String?
  title                String?
  phone                String?
  website              String?
  isActive             Boolean                @default(true)
  assignmentsSubmitted AssignmentSubmission[]
  certificates         Certificate[]
  managedCourses       CourseInstructor[]
  enrollments          Enrollment[]
  progress             LessonProgress[]
  notes                Note[]
  orders               Order[]
  quizAttempts         QuizAttempt[]
  reviews              Review[]
  reviewReplies        Review[]               @relation("ReviewReplies")
}

model Course {
  id               String             @id @default(uuid())
  title            String
  slug             String             @unique
  description      String
  category         String
  level            String
  thumbnail        String
  price            Decimal            @db.Decimal(10, 2)
  priceOld         Decimal?           @db.Decimal(10, 2)
  currency         String             @default("INR")
  status           CourseStatus       @default(DRAFT)
  whatYouWillLearn String[]           @default([])
  requirements     String[]           @default([])
  promoVideoUrl    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  certificates     Certificate[]
  instructors      CourseInstructor[]
  enrollments      Enrollment[]
  modules          Module[]
  orders           Order[]
  reviews          Review[]

  @@index([slug])
  @@index([status])
}

model CourseInstructor {
  courseId String
  userId   String
  course   Course @relation(fields: [courseId], references: [id])
  user     User   @relation(fields: [userId], references: [id])

  @@id([courseId, userId])
  @@index([courseId, userId])
}

model Module {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lessons   Lesson[]
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, position])
  @@index([courseId])
}

model Lesson {
  id          String           @id @default(uuid())
  moduleId    String
  title       String
  description String
  position    Int
  duration    String
  type        LessonType       @default(VIDEO)
  videoUrl    String?
  published   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assignment  Assignment?
  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  notes       Note[]
  quiz        Quiz?
  resources   Resource[]

  @@unique([moduleId, position])
  @@index([moduleId])
}

model Resource {
  id        String       @id @default(uuid())
  lessonId  String
  title     String
  type      ResourceType
  url       String
  createdAt DateTime     @default(now())
  lesson    Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Quiz {
  id        String        @id @default(uuid())
  lessonId  String        @unique
  questions Question[]
  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts  QuizAttempt[]
}

model Question {
  id      String   @id @default(uuid())
  quizId  String
  text    String
  options Option[]
  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  quizId      String
  score       Int
  passed      Boolean
  attemptedAt DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, quizId])
}

model Assignment {
  id           String                 @id @default(uuid())
  lessonId     String                 @unique
  instructions String
  dueDate      DateTime?
  lesson       Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions  AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String                     @id @default(uuid())
  assignmentId String
  userId       String
  status       AssignmentSubmissionStatus @default(NOT_SUBMITTED)
  fileUrl      String?
  score        Int?
  feedback     String?
  submittedAt  DateTime                   @default(now())
  reviewedAt   DateTime?
  assignment   Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User                       @relation(fields: [userId], references: [id])

  @@index([assignmentId, userId])
}

model Enrollment {
  id         String           @id @default(uuid())
  userId     String
  courseId   String
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  course     Course           @relation(fields: [courseId], references: [id])
  user       User             @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
  @@index([courseId, status])
}

model LessonProgress {
  id             String    @id @default(uuid())
  userId         String
  lessonId       String
  watchedSeconds Int       @default(0)
  completed      Boolean   @default(false)
  lastWatchedAt  DateTime  @default(now())
  completedAt    DateTime?
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId, lessonId])
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, lessonId])
}

model Review {
  id          String    @id @default(uuid())
  userId      String
  courseId    String
  rating      Int
  comment     String?
  reply       String?
  repliedAt   DateTime?
  repliedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  course      Course    @relation(fields: [courseId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  repliedBy   User?     @relation("ReviewReplies", fields: [repliedById], references: [id])

  @@unique([userId, courseId])
  @@index([courseId])
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  courseId        String
  amount          Decimal     @db.Decimal(10, 2)
  currency        String      @default("INR")
  status          OrderStatus @default(PENDING)
  providerOrderId String      @unique
  createdAt       DateTime    @default(now())
  course          Course      @relation(fields: [courseId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
  payments        Payment[]

  @@index([providerOrderId])
  @@index([userId, courseId])
  @@index([status])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  provider          String        @default("PAYU")
  providerPaymentId String        @unique
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  order             Order         @relation(fields: [orderId], references: [id])

  @@index([providerPaymentId])
}

model Certificate {
  id                String   @id @default(uuid())
  userId            String
  courseId          String
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())
  course            Course   @relation(fields: [courseId], references: [id])
  user              User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
}

model WebhookEvent {
  id              String    @id @default(uuid())
  providerEventId String    @unique @map("provider_event_id")
  eventType       String    @map("event_type")
  status          String    @default("RECEIVED") @map("status")
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
}

enum UserRole {
  STUDENT
  ADMIN
  INSTRUCTOR
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  TEXT
}

enum ResourceType {
  PDF
  DOCUMENT
  PROJECT_FILE
  EXTERNAL_LINK
}

enum AssignmentSubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  REVIEWED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
